.DS_Store
Thumbs.db
.vscode/settings.json

# Full-resolution original working screenshots stay local-only.
# Public, optimized copies live one level up in assets/images/projects/<project>/.
# (Only affects untracked files; source files committed earlier remain tracked.)
assets/images/projects/*/source/

# Full-resolution portrait originals stay local-only; the site uses the optimized variants.
assets/images/profile/profile-studio-original.png
assets/images/profile/profile-graduation-original.png

# Full-resolution NEXT-CARE funnel and GHL captures supplied in the project folder stay local-only;
# the site uses the optimized funnel-*.webp and ncmc-*.webp derivatives.
assets/images/projects/next-care/*.png
